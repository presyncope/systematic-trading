# Toss Securities Open API client credentials (issued under WTS Settings > Open API)
TOSS_CLIENT_ID=c_xxxxxxxxxxxxxxxxxxxxxxxx
TOSS_CLIENT_SECRET=s_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Korea Investment & Securities (KIS Developers) live-trading app key/secret and the account
# number as "8 digits-2 digits" (종합계좌번호-계좌상품코드)
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=12345678-01

# Ghostfolio security token (shown once at "Get Started"), used by toss-export-ghostfolio --cash
GHOSTFOLIO_ACCESS_TOKEN=

# Discord or Slack incoming-webhook URL for daily-sync notifications (failures, decisions needed)
NOTIFY_WEBHOOK_URL=

# Telegram notifications: bot token from @BotFather, chat id printed by `uv run daily-sync --notify-test`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
